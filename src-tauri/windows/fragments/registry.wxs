<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="PaperNestInstallMarker" Guid="*" Win64="yes">
        <RegistryKey Root="HKLM"
                     Key="Software\PaperNest"
                     ForceCreateOnInstall="yes"
                     ForceDeleteOnUninstall="yes">
          <RegistryValue Name="InstallLocation" Type="string" Value="[INSTALLDIR]" />
          <RegistryValue Name="ExecutablePath" Type="string" Value="[INSTALLDIR]PaperNest.exe" />
          <RegistryValue Name="Version" Type="string" Value="[ProductVersion]" />
          <RegistryValue Name="InstallType" Type="string" Value="MSI" KeyPath="yes" />
        </RegistryKey>
      </Component>

      <Component Id="PaperNestFileAssociations" Guid="*" Win64="yes">
        <RegistryValue Root="HKCU"
                       Key="Software\Classes\PaperNest.Markdown"
                       Type="string"
                       Value="PaperNest Markdown Document"
                       KeyPath="yes" />
        <RegistryValue Root="HKCU"
                       Key="Software\Classes\PaperNest.Markdown\DefaultIcon"
                       Type="string"
                       Value="&quot;[INSTALLDIR]PaperNest.exe&quot;,0" />
        <RegistryValue Root="HKCU"
                       Key="Software\Classes\PaperNest.Markdown\shell\open\command"
                       Type="string"
                       Value="&quot;[INSTALLDIR]PaperNest.exe&quot; &quot;%1&quot;" />

        <RegistryValue Root="HKCU"
                       Key="Software\Classes\Applications\PaperNest.exe"
                       Name="FriendlyAppName"
                       Type="string"
                       Value="PaperNest" />
        <RegistryValue Root="HKCU"
                       Key="Software\Classes\Applications\PaperNest.exe\shell\open\command"
                       Type="string"
                       Value="&quot;[INSTALLDIR]PaperNest.exe&quot; &quot;%1&quot;" />

        <RegistryValue Root="HKCU"
                       Key="Software\Classes\Applications\PaperNest.exe\SupportedTypes"
                       Name=".md"
                       Type="string"
                       Value="" />
        <RegistryValue Root="HKCU"
                       Key="Software\Classes\Applications\PaperNest.exe\SupportedTypes"
                       Name=".markdown"
                       Type="string"
                       Value="" />
        <RegistryValue Root="HKCU"
                       Key="Software\Classes\Applications\PaperNest.exe\SupportedTypes"
                       Name=".mdx"
                       Type="string"
                       Value="" />

        <RegistryValue Root="HKCU"
                       Key="Software\Classes\.md\OpenWithProgids"
                       Name="PaperNest.Markdown"
                       Type="string"
                       Value="" />
        <RegistryValue Root="HKCU"
                       Key="Software\Classes\.markdown\OpenWithProgids"
                       Name="PaperNest.Markdown"
                       Type="string"
                       Value="" />
        <RegistryValue Root="HKCU"
                       Key="Software\Classes\.mdx\OpenWithProgids"
                       Name="PaperNest.Markdown"
                       Type="string"
                       Value="" />

        <RegistryValue Root="HKCU"
                       Key="Software\Classes\.md\OpenWithList"
                       Name="PaperNest.exe"
                       Type="string"
                       Value="" />
        <RegistryValue Root="HKCU"
                       Key="Software\Classes\.markdown\OpenWithList"
                       Name="PaperNest.exe"
                       Type="string"
                       Value="" />
        <RegistryValue Root="HKCU"
                       Key="Software\Classes\.mdx\OpenWithList"
                       Name="PaperNest.exe"
                       Type="string"
                       Value="" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <Fragment>
    <CustomAction Id="PaperNestRegisterAssociationsAction"
                  FileKey="Path"
                  ExeCommand="--papernest-msi-register"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="check" />
    <CustomAction Id="PaperNestUnregisterAssociationsAction"
                  FileKey="Path"
                  ExeCommand="--papernest-msi-unregister"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="PaperNestRegisterAssociationsAction"
              After="InstallFiles">NOT REMOVE~="ALL"</Custom>
      <Custom Action="PaperNestUnregisterAssociationsAction"
              Before="RemoveFiles">REMOVE~="ALL"</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
